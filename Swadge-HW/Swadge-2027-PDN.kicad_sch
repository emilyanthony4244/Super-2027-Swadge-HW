		(uuid "ff2a58cc-9775-4005-8c7d-4a3899122c8f")
	)
	(text_box "VREGN = 4.8V, RTH_{cold} = 27.28k @ 0°C, RTH_{hot} = 5.827k @ 40°C\nV_{ltf} = VREGN * 0.7350, V_{htf} = VREGN * 0.472, V_{tco} = VREGN * 0.447\n(Derating from 45°C to 40°C)\n\nRT2 =\nV_{regn} x RTH_{cold} x RTH_{hot} x ( 1/V_{ltf} - 1/V_{tco} )\n/\nRTH_{hot} x ( V_{regn}/V_{tco} - 1 ) - RTH_{cold} x ( V_{regn}/V_{ltf} - 1 )\n=\n4.8V * 27.28k * 5.827k * ( 1/3.528V - 1/2.1456V )\n/\n5.827k * ( 4.8V/2.1456V - 1 ) - 27.28k * ( 4.8V/3.528V - 1 )\n\n=139344063.9 / 2626.86 = 53.05kohm\n\nRT1 = (V_{regn}/V_{ltf} - 1 )\n/\n( 1/RT2 ) + ( 1/RTH_{cold} )\n=\n(4.8/3.528 - 1)\n/\n(1/53.05k) + (1/27.28k)\n=0.36054 / 0.05551 = 6.495k\n\nRT1_{ideal} = 6.495k\nRT2_{ideal} = 53.05kohm\n\nRT1_{E96} = 6.490k\nRT2_{E96} = 53.6k\n"
		(exclude_from_sim no)
		(at 213.36 96.52 0)
		(size 66.04 67.3318)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "854492d4-bf0a-4529-886d-36bc2e110473")
	)
